# APAAR Portal Backend — Environment Configuration
# IMPORTANT: Never commit this file to GitHub/public repositories

# Secret key used to sign JWT tokens (change this to a long random string in production)
SECRET_KEY=apaar_portal_secret_key_skcet_2024_do_not_share

# JWT token algorithm
ALGORITHM=HS256

# How long JWT token stays valid (in minutes). 480 = 8 hours
ACCESS_TOKEN_EXPIRE_MINUTES=480

# SQLite database file location (relative to backend/ folder)
DATABASE_URL=sqlite:///./apaar_portal.db
